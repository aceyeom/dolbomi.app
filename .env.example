# The room's database (Supabase). Copy to .env.local for local work, and set
# the same two in Vercel, Project, Settings, Environment Variables.
# Both are public by design: what a visitor may do is decided by the database
# (supabase/migrations), not by keeping these secret.
#
# Without them the site still runs: the index is drawn from src/data/works.js
# and the note form says it is not taking notes.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
